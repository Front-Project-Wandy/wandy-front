# 키 이름만 적는다. 실제 값은 각자 .env.local 에 넣고 절대 커밋하지 않는다.
# VITE_ 는 브라우저에 노출되므로 도메인 제한을 건 지도 표시용 키에만 쓴다.
# 지도 키가 비어 있으면 플래너 지도 자리에 안내만 나온다. 키를 넣은 뒤 개발 서버를 다시 켠다.
# 네이버 검색·TourAPI·Gemini·Directions 같은 비밀 키는 프론트에 두지 않는다 (2단계 백엔드에서만).
# 네이버: 네이버 클라우드 Maps의 Application > 인증 정보에서 Client ID(짧은 값)를 넣는다.
#   Client Secret(긴 값)은 넣으면 안 된다 — 브라우저에 그대로 노출되고 인증도 실패(500)한다.
#   Web 서비스 URL은 포트·경로 없이 http://localhost 로 등록하고, Dynamic Map을 선택해 둔다.
VITE_NAVER_MAP_CLIENT_ID=
# 구글: Maps JavaScript API를 켜고, HTTP 리퍼러 제한에 http://localhost:5173/* 를 넣는다.
VITE_GOOGLE_MAPS_API_KEY=
# 배포 주소 (https://로 시작, 끝에 / 없이). 공유 미리보기(og:image·og:url, 요구사항 98)에 쓴다.
# 비밀 값이 아니라 공개 주소라 VITE_를 붙여도 된다. 비워 두면 공유 카드 이미지가 뜨지 않는다.
VITE_SITE_URL=
# 대화형 여행 비서(요구사항 101)의 Gemini 키. Google AI Studio에서 발급한다.
# VITE_를 붙이지 않는다 — 개발 서버(vite-plugins/geminiProxy.js)만 읽고 브라우저로는 보내지 않는다.
# npm run dev에서만 쓰이고, 비어 있거나 배포판이면 가짜 비서가 대신 답한다. 2단계에서는 백엔드로 옮긴다.
GEMINI_API_KEY=
# 비워 두면 gemini-3.8-flash를 쓴다. 모델 이름이 바뀌면 여기만 바꾼다.
GEMINI_MODEL=
